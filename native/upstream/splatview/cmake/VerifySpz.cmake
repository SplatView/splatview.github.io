# Verify the entire pinned SPZ source closure, including explicitly reviewed
# local modifications. SOURCE_BASELINE.json remains historical and immutable.
cmake_minimum_required(VERSION 3.25)

function(_splatview_spz_path value)
    if(NOT value MATCHES "^third_party/spz/[A-Za-z0-9_./-]+$" OR
       value MATCHES "(^|/)\\.\\.?(/|$)" OR value MATCHES "//" OR value MATCHES "/$")
        message(FATAL_ERROR "Invalid SPZ lock path: ${value}")
    endif()
endfunction()

function(_splatview_spz_hash value)
    string(LENGTH "${value}" length)
    if(NOT length EQUAL 64 OR NOT value MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Invalid SPZ SHA-256: ${value}")
    endif()
endfunction()

function(splatview_verify_spz root)
    set(baseline_path "${root}/SOURCE_BASELINE.json")
    set(lock_path "${root}/third_party/spz/LOCAL_PATCHES.json")
    file(READ "${baseline_path}" baseline)
    file(READ "${lock_path}" lock)
    string(JSON schema GET "${lock}" schemaVersion)
    if(NOT schema STREQUAL "1")
        message(FATAL_ERROR "Unsupported SPZ patch lock schema")
    endif()
    file(SHA256 "${baseline_path}" baseline_sha)
    string(JSON locked_baseline GET "${lock}" baselineSha256)
    string(JSON commit GET "${baseline}" dependencies spz)
    string(JSON locked_commit GET "${lock}" upstreamCommit)
    if(NOT baseline_sha STREQUAL locked_baseline OR NOT commit STREQUAL locked_commit)
        message(FATAL_ERROR "SPZ patch lock does not identify this source baseline/commit")
    endif()

    set(baseline_paths)
    string(JSON count LENGTH "${baseline}" files)
    if(count LESS 1)
        message(FATAL_ERROR "Empty source baseline")
    endif()
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON path GET "${baseline}" files ${index} destination)
        if(path MATCHES "^third_party/spz/")
            _splatview_spz_path("${path}")
            if(path IN_LIST baseline_paths)
                message(FATAL_ERROR "Duplicate SPZ baseline path: ${path}")
            endif()
            string(JSON sha GET "${baseline}" files ${index} sha256)
            _splatview_spz_hash("${sha}")
            list(APPEND baseline_paths "${path}")
            string(SHA256 key "${path}")
            set("upstream_${key}" "${sha}")
        endif()
    endforeach()
    list(LENGTH baseline_paths expected_count)
    string(JSON count LENGTH "${lock}" sourceFiles)
    if(expected_count LESS 1 OR NOT count EQUAL expected_count)
        message(FATAL_ERROR "SPZ patch lock must cover the complete baseline source closure")
    endif()
    set(locked_paths)
    set(changed_paths)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON path GET "${lock}" sourceFiles ${index} path)
        _splatview_spz_path("${path}")
        if(NOT path IN_LIST baseline_paths OR path IN_LIST locked_paths)
            message(FATAL_ERROR "Unexpected or duplicate SPZ source path: ${path}")
        endif()
        string(JSON original GET "${lock}" sourceFiles ${index} upstreamSha256)
        string(JSON sha GET "${lock}" sourceFiles ${index} sha256)
        string(JSON bytes GET "${lock}" sourceFiles ${index} bytes)
        _splatview_spz_hash("${original}")
        _splatview_spz_hash("${sha}")
        string(SHA256 key "${path}")
        if(NOT original STREQUAL "${upstream_${key}}")
            message(FATAL_ERROR "SPZ upstream hash differs from immutable baseline: ${path}")
        endif()
        if(NOT bytes MATCHES "^(0|[1-9][0-9]*)$")
            message(FATAL_ERROR "Invalid SPZ locked byte length: ${path}")
        endif()
        file(SHA256 "${root}/${path}" actual_sha)
        file(SIZE "${root}/${path}" actual_bytes)
        if(NOT actual_sha STREQUAL sha OR NOT actual_bytes EQUAL bytes)
            message(FATAL_ERROR "Locked SPZ source changed: ${path}")
        endif()
        if(NOT original STREQUAL sha)
            list(APPEND changed_paths "${path}")
        endif()
        list(APPEND locked_paths "${path}")
    endforeach()

    # The changed-file list requires a reason and must exactly match the hashes.
    string(JSON count LENGTH "${lock}" changes)
    set(described_changes)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON path GET "${lock}" changes ${index} path)
            string(JSON reason GET "${lock}" changes ${index} reason)
            string(STRIP "${reason}" reason)
            if(NOT path IN_LIST changed_paths OR path IN_LIST described_changes OR reason STREQUAL "")
                message(FATAL_ERROR "Invalid SPZ local-change record: ${path}")
            endif()
            list(APPEND described_changes "${path}")
        endforeach()
    endif()
    list(SORT changed_paths)
    list(SORT described_changes)
    if(NOT changed_paths STREQUAL described_changes)
        message(FATAL_ERROR "SPZ changed-file list does not match source hashes")
    endif()

    # Local documentation is independently locked; the manifest cannot hash
    # itself. No unlisted vendor file is permitted to join the build closure.
    string(JSON count LENGTH "${lock}" auxiliaryFiles)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "SPZ patch lock requires its local change notice")
    endif()
    string(JSON path GET "${lock}" auxiliaryFiles 0 path)
    string(JSON sha GET "${lock}" auxiliaryFiles 0 sha256)
    string(JSON bytes GET "${lock}" auxiliaryFiles 0 bytes)
    if(NOT path STREQUAL "third_party/spz/LOCAL_CHANGES.md")
        message(FATAL_ERROR "Unexpected SPZ patch auxiliary file")
    endif()
    _splatview_spz_hash("${sha}")
    file(SHA256 "${root}/${path}" actual_sha)
    file(SIZE "${root}/${path}" actual_bytes)
    if(NOT bytes MATCHES "^(0|[1-9][0-9]*)$" OR
       NOT actual_sha STREQUAL sha OR NOT actual_bytes EQUAL bytes)
        message(FATAL_ERROR "Locked SPZ local change notice changed")
    endif()
    list(APPEND locked_paths "${path}" "third_party/spz/LOCAL_PATCHES.json")
    if(CMAKE_SCRIPT_MODE_FILE)
        file(GLOB_RECURSE actual_paths LIST_DIRECTORIES FALSE RELATIVE "${root}" "${root}/third_party/spz/*")
    else()
        file(GLOB_RECURSE actual_paths CONFIGURE_DEPENDS LIST_DIRECTORIES FALSE RELATIVE "${root}" "${root}/third_party/spz/*")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
            "${baseline_path}" "${lock_path}")
        foreach(path IN LISTS locked_paths)
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${root}/${path}")
        endforeach()
    endif()
    list(SORT actual_paths)
    list(SORT locked_paths)
    if(NOT actual_paths STREQUAL locked_paths)
        message(FATAL_ERROR "SPZ vendor file inventory differs from its reviewed closure")
    endif()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    if(NOT DEFINED SPLATVIEW_VERIFY_ROOT)
        message(FATAL_ERROR "Pass -DSPLATVIEW_VERIFY_ROOT=<source checkout>")
    endif()
    splatview_verify_spz("${SPLATVIEW_VERIFY_ROOT}")
    message(STATUS "Verified pinned SPZ closure and explicit local patch lock")
endif()
